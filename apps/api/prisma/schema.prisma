generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum DeviceStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  URL
  FEED
  WIDGET
}

enum WidgetTemplate {
  INFORMATIVE_DASHBOARD
  NEWS
  WEATHER
  KPI
  KPI_GRID
  MARKET_TICKER
  TABLE
  LIST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Device {
  id             String       @id @default(cuid())
  name           String
  hardwareId     String       @unique
  tokenHash      String       @unique
  status         DeviceStatus @default(ACTIVE)
  resolution     String?
  ipAddress      String?
  appVersion     String?
  lastSeenAt     DateTime?
  lastQueuePullAt DateTime?
  nowPlayingId   String?
  nowPlayingName String?
  nowPlayingAt   DateTime?
  screenshotUrl  String?
  playerAccessId String?
  playerAccess   PlayerAccess? @relation(fields: [playerAccessId], references: [id], onDelete: SetNull)
  forcedPlaylistId String?
  forcedPlaylist   Playlist?    @relation("ForcedPlayback", fields: [forcedPlaylistId], references: [id], onDelete: SetNull)
  forcedCommandId  String?
  forcedAt         DateTime?
  schedules      Schedule[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([lastSeenAt])
  @@index([playerAccessId])
  @@index([forcedPlaylistId])
}

model PlayerAccess {
  id           String   @id @default(cuid())
  label        String
  username     String   @unique
  passwordHash String
  enabled      Boolean  @default(true)
  deviceLimit  Int      @default(1)
  lastUsedAt   DateTime?
  devices      Device[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Media {
  id           String         @id @default(cuid())
  name         String
  type         MediaType
  fileName     String?
  originalName String?
  mimeType     String?
  sizeBytes    BigInt?
  url          String?
  thumbnailUrl String?
  durationSec  Int?
  feedRefreshSec Int?
  checksum     String?
  dataWidget   DataWidget?
  playlistItems PlaylistItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model DataWidget {
  id               String         @id @default(cuid())
  mediaId          String         @unique
  endpoint         String
  template         WidgetTemplate
  refreshSeconds   Int            @default(300)
  mapping          Json
  style            Json?
  authHeaderName   String?
  authEnvVar       String?
  enabled          Boolean        @default(true)
  lastSuccessAt    DateTime?
  lastError        String?
  media            Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([enabled])
}

model Playlist {
  id          String         @id @default(cuid())
  name        String
  description String?
  isActive    Boolean        @default(true)
  loop        Boolean        @default(true)
  items       PlaylistItem[]
  schedules   Schedule[]
  forcedDevices Device[]       @relation("ForcedPlayback")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PlaylistItem {
  id          String   @id @default(cuid())
  playlistId  String
  mediaId     String
  position    Int
  durationSec Int
  useMediaDuration Boolean @default(false)
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([playlistId, position])
  @@index([playlistId])
}

model Schedule {
  id         String   @id @default(cuid())
  name       String
  deviceId   String
  playlistId String
  startDate  DateTime?
  endDate    DateTime?
  daysOfWeek Int[]
  startTime  String
  endTime    String
  priority   Int      @default(0)
  enabled    Boolean  @default(true)
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([deviceId, enabled])
}
