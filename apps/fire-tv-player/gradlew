#!/bin/sh
set -eu

GRADLE_VERSION=8.9
SIGNAGE_GRADLE_HOME="${GRADLE_USER_HOME:-${PWD}/.gradle}"
GRADLE_DIR="${SIGNAGE_GRADLE_HOME}/corporate-signage/gradle-${GRADLE_VERSION}"
GRADLE_ZIP="${TMPDIR:-/tmp}/corporate-signage-gradle-${GRADLE_VERSION}.zip"

if [ ! -x "${GRADLE_DIR}/bin/gradle" ]; then
  echo "Baixando Gradle ${GRADLE_VERSION} pela primeira vez..."
  mkdir -p "${SIGNAGE_GRADLE_HOME}/corporate-signage"
  curl -fL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "${GRADLE_ZIP}"
  unzip -q -o "${GRADLE_ZIP}" -d "${SIGNAGE_GRADLE_HOME}/corporate-signage"
  rm -f "${GRADLE_ZIP}"
fi

exec "${GRADLE_DIR}/bin/gradle" "$@"
