POSTGRES_DB=signage
POSTGRES_USER=signage
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://signage:change-this-database-password@postgres:5432/signage?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
ENROLLMENT_KEY=replace-with-a-private-device-enrollment-key
ADMIN_EMAIL=admin@empresa.local
ADMIN_PASSWORD=replace-this-before-first-start
API_PORT=3000
PUBLIC_API_URL=http://192.168.1.10:3000
VITE_API_URL=http://192.168.1.10:3000/api
VITE_SOCKET_URL=http://192.168.1.10:3000
CORS_ORIGINS=http://localhost:4173,http://localhost:4174,http://192.168.1.10:8080,http://192.168.1.10:8081
NEWS_API_KEY=
# Segredos de widgets ficam somente no servidor. O token da brapi libera a lista financeira completa.
WIDGET_SECRET_BRAPI=
# Hosts privados explicitamente autorizados para APIs internas, separados por vírgula.
WIDGET_PRIVATE_HOST_ALLOWLIST=
MEDIA_INBOX_DIR=./media-inbox
